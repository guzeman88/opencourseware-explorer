# ============================================================
# The Commons — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git.
# ============================================================

# ---- Database -----------------------------------------------
# Full asyncpg connection string for Neon (or any PostgreSQL 15+)
# For Neon: copy from https://console.neon.tech → Connection Details
# Append ?sslmode=require for Neon
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?sslmode=require

# ---- Application --------------------------------------------
# Generate with: openssl rand -hex 32
# NEVER use the default in production — all JWTs will be forgeable
SECRET_KEY=change-me-to-a-64-char-random-hex-string-in-prod

# Set to "production" on Render
ENVIRONMENT=development

# ---- CORS ---------------------------------------------------
# Comma-separated list of allowed origins for the API
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# ---- Admin Bootstrap ----------------------------------------
# Admin account created at startup if it doesn't exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme_strong_password

# ---- YouTube Data API v3 ------------------------------------
# Required for scraper video enrichment
# Get from: https://console.cloud.google.com/ (free, 10k units/day)
# Not needed for the API or frontend to run
YOUTUBE_API_KEY=

# ---- Frontend (web/.env.local) ------------------------------
# URL of the backend API — used by Next.js at build time and runtime
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX)
# Leave empty to disable analytics; set in Netlify dashboard for production
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---- Sentry (optional) --------------------------------------
# Sentry DSN for error reporting (frontend and backend)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
