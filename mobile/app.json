{
  "expo": {
    "name": "OCW Explorer",
    "slug": "ocw-explorer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#141414"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ocwexplorer.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#141414"
      },
      "package": "com.ocwexplorer.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "@sentry/react-native/expo"],
    "scheme": "ocw",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "sentryDsn": "",
      "eas": {
        "projectId": ""
      }
    }
  }
}
